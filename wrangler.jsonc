{
  // Hébergement Cloudflare : le site est un export statique (dossier out/,
  // produit par `npm run build`), servi tel quel sans code serveur.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keyspneu77",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./out",
    // Adresse inconnue → la page 404 générée par Next plutôt qu'une erreur brute.
    "not_found_handling": "404-page"
  }
}
